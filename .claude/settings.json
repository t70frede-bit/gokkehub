{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(wrangler pages deploy:*)",
      "Bash(wrangler pages publish:*)",
      "Bash(npx wrangler pages deploy:*)",
      "Bash(npx wrangler pages publish:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/scan-staged-secrets.mjs"],
            "if": "Bash(git commit*)",
            "statusMessage": "Scanning staged changes for secrets…",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
